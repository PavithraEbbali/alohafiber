# Original generator output (PNG, ~28MB). Not needed to build — the optimised
# JPEGs the site actually serves live in public/images/ and ARE committed.
# Keeping these out stops 28MB entering git history permanently and being
# re-cloned on every Vercel build. They remain on disk locally.
design/source-images/

# Local editor/tooling config
.claude/

# Portable build output and the zip made from it. Both are generated by
# `npm run build:portable` from committed source, so they are artifacts, not
# inputs — and the zip is ~1.3MB of binary that would bloat history on every
# rebuild.
portable/
*.zip
